# Copy this file to .env.local and fill in real values. .env.local is
# gitignored; this file (placeholders only, no secrets) is committed so
# anyone setting up the project knows exactly what it needs.

# --- Supabase (Project Settings -> API) ---

# Safe to expose to the browser — access is entirely governed by the RLS
# policies in supabase/schema.sql, not by keeping this secret.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only. Bypasses Row Level Security entirely — never expose this to
# the browser, never commit it. Used only in server-side code (Server
# Actions, Server Components) for the two things the anon key genuinely
# can't do: reading appointments to compute availability, and looking up
# an appointment by its cancellation token.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Resend (resend.com/api-keys) ---

# Server-only.
RESEND_API_KEY=your-resend-api-key

# Without a verified sending domain, Resend's test mode only delivers to
# the email address the account was signed up with — fine for local dev
# and for this portfolio piece, but worth knowing before you wonder why a
# "customer" email never arrives.
RESEND_FROM_EMAIL=Ironclad Barbers <onboarding@resend.dev>

# Where the shop-side "you've got a new booking" notification goes.
SHOP_NOTIFICATION_EMAIL=hello@ironcladbarbers.example.com
